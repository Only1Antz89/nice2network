# Vercel Postgres / Neon
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
AUTH_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# Google Cloud OAuth app
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID app
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Public Vercel URL, e.g. https://nice2network.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verification email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=nice 2 network <hello@yourdomain.com>

# One-time master administrator bootstrap. Never commit real values.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_TEMP_PASSWORD=

# Protects the daily analytics aggregation and 90-day raw-event cleanup.
CRON_SECRET=

# n2 project-team blueprint and semantic-retrieval providers.
# The active provider is selected in /admin/system; providers never auto-failover.
OPENAI_API_KEY=
OPENAI_BLUEPRINT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_BLUEPRINT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
